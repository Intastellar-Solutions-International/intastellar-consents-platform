# Set these in the server environment (Apache SetEnv, php-fpm, systemd), OR point PHP at a secrets file:
# DOMAIN_CLASSIFICATION_ENV_FILE=/absolute/path/to/this-file-on-server.env
#
# Canonical PHP script for editing / upload: your FileZilla temp copy
#   …/T/fz3temp-2/domainClassification.php
# (no longer stored under this repo’s server/cmp/.)
#
# DB_* — table must include: id, domain, category, updated_on.

DB_HOST=intastellarsolutions.com.mysql
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name

# Table containing domains (columns: id, domain, category, updated_on, …)
DOMAIN_TABLE=domains

# Google Cloud Natural Language — create an API key with "Cloud Natural Language API" enabled.
GOOGLE_NATURAL_LANGUAGE_API_KEY=your_api_key_here

# Required for HTTP-triggered runs (GET or POST ?cron_token=…)
DOMAIN_CLASSIFICATION_CRON_TOKEN=generate_a_long_random_string

# Max domains per run (free tier ~5k classifyText units/month; tune for your volume)
DOMAIN_CLASSIFICATION_BATCH_LIMIT=400

# Optional: only rows not updated in this many days (0 = ignore, process up to BATCH_LIMIT by oldest updated_on)
DOMAIN_CLASSIFICATION_MIN_AGE_DAYS=25

# --- Vercel (project env for api/domain-classification-cron.js) ---
# CRON_SECRET              — Vercel injects for Cron invocations; do not set manually unless testing.
# DOMAIN_CLASSIFICATION_CRON_TOKEN — same value as on the PHP server (passed as cron_token + X-Cron-Token).
# DOMAIN_CLASSIFICATION_ENDPOINT   — optional; default https://apis.intastellarsolutions.com/cmp/domainClassification
# DOMAIN_CLASSIFICATION_FETCH_MS   — optional upstream timeout (default 240000). maxDuration in vercel.json is 300s.
