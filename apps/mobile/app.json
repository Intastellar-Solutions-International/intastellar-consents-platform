{
  "expo": {
    "name": "Intastellar Analytics",
    "slug": "intastellar-analytics",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.intastellar.analytics",
      "infoPlist": {}
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#373737",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.intastellar.analytics"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#373737",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-font"
    ],
    "scheme": "intastellaranalytics",
    "backgroundColor": "#373737",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "63e03f01-ca8e-4bd7-ab76-e51ce9b31910"
      }
    }
  }
}
