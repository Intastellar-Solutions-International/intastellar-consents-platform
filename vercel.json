{
  "version": 2,
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron-scan-domains",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "api/cookie-audit.js": {
      "memory": 1536,
      "maxDuration": 20
    },
    "api/pre-consent-scan.js": {
      "memory": 1536,
      "maxDuration": 90,
      "regions": ["iad1"]
    },
    "api/pre-consent-scan-public.js": {
      "memory": 1536,
      "maxDuration": 90,
      "regions": ["iad1"]
    },
    "api/cookie-banner.js": {
      "memory": 1536,
      "maxDuration": 90,
      "regions": ["iad1"]
    },
    "api/cookie-banner-scan.js": {
      "memory": 1536,
      "maxDuration": 90,
      "regions": ["iad1"]
    },
    "api/scan-domain-task.js": {
      "memory": 1536,
      "maxDuration": 90,
      "regions": ["iad1"]
    },
    "api/scan-domain-task-eu.js": {
      "memory": 1536,
      "maxDuration": 90,
      "regions": ["fra1"]
    },
    "api/scan-domain-task-ap.js": {
      "memory": 1536,
      "maxDuration": 90,
      "regions": ["sin1"]
    },
    "api/cron-scan-domains.js": {
      "memory": 256,
      "maxDuration": 90
    }
  }
}
