___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// Intastellar Analytics: loads the tracker (and optionally the consent
// banner first). The tracker reads the visitor's banner choice itself, so
// this tag needs no extra GTM consent checks.
const injectScript = require('injectScript');
const encodeUriComponent = require('encodeUriComponent');

const TRACKER = 'https://analytics.consentsmanagement.com/api/a?id=' + encodeUriComponent(data.siteKey);
const BANNER_CORE = 'https://consents.cdn.intastellarsolutions.com/uc.js';

const loadTracker = () => {
  injectScript(TRACKER, data.gtmOnSuccess, data.gtmOnFailure, 'intastellar-analytics');
};

if (data.loadBanner) {
  // The banner's configuration must be in place before its core script runs.
  const bannerConfig = 'https://downloads.intastellarsolutions.com/cookieconsents/' + encodeUriComponent(data.bannerDomain) + '/config.js';
  injectScript(bannerConfig, () => {
    injectScript(BANNER_CORE, loadTracker, data.gtmOnFailure, 'intastellar-banner');
  }, data.gtmOnFailure, 'intastellar-banner-config');
} else {
  loadTracker();
}


