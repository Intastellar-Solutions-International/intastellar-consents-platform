___TESTS___

scenarios:
- name: Loads the tracker with the site key
  code: |-
    const injected = [];
    mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
      injected.push(url);
      onSuccess();
    });
    runCode({ siteKey: 'AbCdEf12_-xyZ789', loadBanner: false });
    assertThat(injected).isEqualTo(['https://analytics.consentsmanagement.com/api/a?id=AbCdEf12_-xyZ789']);
    assertApi('gtmOnSuccess').wasCalled();
- name: Loads banner config, banner, then tracker - in that order
  code: |-
    const injected = [];
    mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
      injected.push(url);
      onSuccess();
    });
    runCode({ siteKey: 'AbCdEf12_-xyZ789', loadBanner: true, bannerDomain: 'example.com' });
    assertThat(injected).isEqualTo([
      'https://downloads.intastellarsolutions.com/cookieconsents/example.com/config.js',
      'https://consents.cdn.intastellarsolutions.com/uc.js',
      'https://analytics.consentsmanagement.com/api/a?id=AbCdEf12_-xyZ789'
    ]);
    assertApi('gtmOnSuccess').wasCalled();
- name: Fails the tag when the banner can't load (tracker not loaded)
  code: |-
    const injected = [];
    mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
      injected.push(url);
      onFailure();
    });
    runCode({ siteKey: 'AbCdEf12_-xyZ789', loadBanner: true, bannerDomain: 'example.com' });
    assertThat(injected.length).isEqualTo(1);
    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();


